{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start --sourceRoot .. --entryFile server/src/main",
    "start:dev": "nest start --watch --sourceRoot .. --entryFile server/src/main",
    "start:debug": "nest start --debug --watch --sourceRoot .. --entryFile server/src/main",
    "start:prod": "node dist/server/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@supabase/supabase-js": "^2",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "date-fns": "^3",
    "multer": "^1",
    "openai": "^4",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/schematics": "^10",
    "@types/express": "^4",
    "@types/multer": "^1",
    "@types/node": "^20",
    "typescript": "^5",
    "ts-loader": "^9",
    "ts-node": "^10",
    "source-map-support": "^0.5"
  }
}
